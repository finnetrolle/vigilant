#!/bin/sh
# Pre-push gate: compile with warnings-as-errors, run tests and detekt.
# Full verification with the CVE scan is available via ./gradlew verifyAll.
# Mutation testing remains an explicit separate ./gradlew pitest run.
echo "Running pre-push verification (./gradlew build)..."
./gradlew build
if [ $? -ne 0 ]; then
    echo "Pre-push verification failed. Push aborted."
    exit 1
fi
