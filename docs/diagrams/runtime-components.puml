@startuml
title Компоненты исполняемой системы Vigilant
skinparam componentStyle uml2
left to right direction

actor "Клиент" as Client
cloud "Вышестоящий сервер OpenAI" as Upstream
cloud "Trusted identity Bridge" as Bridge
cloud "Container-managed stdout" as Stdout

node "Процесс Vigilant" as Vigilant {
  component "TrafficAdmissionService" as Admission
  component "MetricsService" as Metrics
  component "TracingService" as Tracing
  component "PiiShadowProxyService" as ShadowProxy
  component "BearerIdentityExtractor\nDummy / offline JWT / External" as Identity
  component "CachingExternalIdentityLookup\nCaffeine completed + bounded in-flight" as Cache
  component "ExternalIdentityCacheKeyHasher\nprocess-local HMAC-SHA-256" as Hasher
  component "BridgeIdentityClient\ntimeout + admission + telemetry" as BridgeClient
  component "OutboundClientResources\none ClientFactory" as Outbound
  component "ShadowInspectionWorkflow" as Workflow
  component "ChatCompletionsRequestParser" as Parser
  component "Сборщик PolicyContext" as Context
  component "PolicyEngine" as PolicyEngine
  component "fast-pii adapter и recognizers" as FastPii
  component "Generic windowing core" as Windowing
  component "ShadowAuditLogger\nLogback AsyncAppender" as AuditLogger
  component "RequestRewritePlanner + RequestMaskingFormatter" as RequestRewrite
  component "BoundedRequestSourceOwner\noriginal quota + patch plan + bounded scratch" as RequestSource
  component "ReplayReadyRequest" as Replay
  component "BypassProxyService" as Transport
  component "RetainedResponseHandler" as ResponseHandler
  component "RetainedResponseSource" as ResponseSource
  component "ChatCompletionsResponseParser" as ResponseParser
  component "ResponseInspectionWorkflow" as ResponseWorkflow
  component "JSON source-map rewriter" as ResponseRewriter
  component "ReplayReadyResponse" as ResponseReplay
  component "ResponseAnalysisLifecycle" as ResponseLifecycle
}

Client --> Admission : HTTP-запрос
Admission --> Metrics
Metrics --> Tracing
Tracing --> ShadowProxy
ShadowProxy --> Identity : blocking-safe validation\nдо body demand
Identity --> Cache : External only\nasync exact token lookup
Cache --> Hasher : transient token -> full digest
Cache --> BridgeClient : cold miss creator only
Outbound --> Cache : close first; callers + entries
Outbound --> Hasher : one EXTERNAL instance
BridgeClient --> Bridge : POST exact endpoint\nempty body
Outbound --> BridgeClient : shared factory lifecycle
Outbound --> Transport : shared factory lifecycle
ShadowProxy --> Workflow : полный ограниченный источник
Workflow --> Parser : представление только для чтения
Parser --> Context : NormalizedProtocolAttributes(model)
Workflow --> PolicyEngine : independent fragments
Context --> PolicyEngine : PolicyContext
PolicyEngine --> FastPii : независимые фрагменты
FastPii --> Windowing : capability и detector contract
Workflow --> AuditLogger : started/completed\nbest-effort pair
AuditLogger --> Stdout : non-blocking JSONL
Workflow --> RequestRewrite : selected free-text MASK
RequestRewrite --> RequestSource : compact immutable patches
Workflow --> Replay : validated ALLOW/MASK Forward
Workflow --> ShadowProxy : policy/structural 403 or technical 503
Replay --> RequestSource : one terminal owner
Replay --> Transport : одноразовая передача владения
Transport --> Upstream : original или exact patched bytes
Upstream --> Transport : потоковый ответ
Transport --> ShadowProxy : gateway-owned exchange handle
ShadowProxy --> ResponseHandler : upstream response
ResponseHandler --> ResponseSource : one-item demand
ResponseHandler --> ResponseWorkflow : complete ordinary/SSE source
ResponseWorkflow --> ResponseSource : полный read-only view
ResponseWorkflow --> ResponseParser : parse + source map
ResponseParser --> ResponseWorkflow : fragments + gaps + source map
ResponseWorkflow --> PolicyEngine : response context + fragments
ResponseWorkflow --> AuditLogger : RESPONSE started/completed pair
ResponseWorkflow --> ResponseRewriter : JSON/SSE MASK only
ResponseWorkflow --> ResponseReplay : ForwardOriginal / ForwardMasked
ResponseReplay --> ResponseHandler : one-shot transport claim
ResponseHandler --> Client : атомарный ответ или safe reject
ResponseLifecycle --> ShadowProxy : запрет нового handoff при shutdown

note bottom of ShadowProxy
Проверяются только запросы POST /v1/chat/completions
с медиатипом application/json.
end note

note bottom of Transport
Transport сохраняет streaming/backpressure.
RetainedResponseHandler удерживает его output в RAM.
end note

note bottom of ResponseSource
Нет application quota, disk spill или persistence.
SSE удерживается до [DONE] и final policy outcome.
end note
@enduml
