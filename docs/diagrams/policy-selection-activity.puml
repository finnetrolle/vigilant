@startuml
title Выбор и вычисление снимка политик
skinparam activity {
  BackgroundColor White
  BorderColor Black
}

start
:Однократно загрузить неизменяемый politics.conf;
:Строго разобрать известные поля HOCON;
:Проверить идентификаторы, детекторы, сроки, реакции и граф переопределений;
if (REQUEST clean=ALLOW и error=BLOCK без transformations?) then (да)
  :Сопоставить enabled policies по URL, model, phase и subject;
  :Canonical order и simultaneous overrides;
  if (Applied policies пусты?) then (да)
    :Original replay без detector/audit;
  else (нет)
    :Один detector invocation на independent fragment;
    :Все fragments и per-policy deadlines;
    if (Technical failure?) then (да)
      :503 до upstream;
    elseif (Policy BLOCK или structural MASK?) then (да)
      :403 до upstream;
    else (нет)
      :Validated non-expanding free-text MASK или original ALLOW;
    endif
  endif
else (нет)
  :Отклонить startup с кодом 2;
endif
stop
@enduml
