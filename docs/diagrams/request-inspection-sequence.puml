@startuml
title Проверка запроса и retained response protocol gate
autonumber

actor "Клиент" as Client
participant "MetricsService" as Metrics
participant "TracingService" as Tracing
participant "TrafficAdmissionService" as Admission
participant "PiiShadowProxyService" as Proxy
participant "Blocking-safe request executor" as Executor
participant "BearerIdentityExtractor" as Identity
participant "CachingExternalIdentityLookup" as Cache
participant "ExternalIdentityCacheKeyHasher" as Hasher
participant "BridgeIdentityClient" as BridgeClient
participant "Trusted identity Bridge" as Bridge
participant "BoundedRequestSource" as Source
participant "ShadowInspectionWorkflow" as Workflow
participant "ChatCompletionsRequestParser" as Parser
participant "RequestRewritePlanner" as Rewriter
participant "ReplayReadyRequest" as Ready
participant "PolicyEngine" as Engine
participant "Logback AsyncAppender\nneverBlock=true" as Audit
participant "BypassProxyService" as Transport
participant "Вышестоящий сервер OpenAI" as Upstream
participant "RetainedResponseHandler" as ResponseHandler
participant "RetainedResponseSource" as ResponseSource
participant "ChatCompletionsResponseParser" as ResponseParser
participant "ResponseInspectionWorkflow" as ResponseWorkflow
participant "JSON source-map rewriter" as ResponseRewriter
participant "ReplayReadyResponse" as ResponseReplay

Client -> Admission : HTTP-запрос
Admission -> Metrics : допущенный запрос
Metrics -> Tracing : status/active metrics
Tracing -> Proxy : итоговый контекст сеанса и трассы
Proxy -> Proxy : проверить метод, путь и медиатип

alt дескриптор не поддерживается
  Proxy --> Client : 400 unsupported_schema
else дескриптор поддерживается
  Proxy -> Executor : проверить identity до body demand
  Executor -> Identity : single Bearer header
  alt External mode
    Identity -> Cache : exact non-empty token
    Cache -> Hasher : full HMAC-SHA-256 key
    alt ready unexpired hit
      Cache --> Identity : normalized identity; no slot/permit/span
    else admitted joined miss
      Cache -> Cache : independent caller, same original deadline
    else admitted new miss
      Cache -> BridgeClient : sole delegate operation
      BridgeClient -> Bridge : POST configured path/query\nBearer token + empty body
      Bridge --> BridgeClient : complete response или failure
      BridgeClient --> Cache : normalized identity / unavailable / cancellation
      Cache -> Cache : cache success before fan-out; release slots
    else exhausted waiter slots
      Cache --> Identity : existing OVERLOADED
    end
    Cache --> Identity : independent caller outcome
    note right of Cache
      Only final caller cancellation aborts Bridge.
      Close drops entries, in-flight state and hasher.
    end note
  else Dummy или JWT
    Identity -> Identity : configured identity или\noffline RS256 + pinned JWK + claims
  end
  alt identity отклонена
    Identity --> Executor : typed safe failure
    Executor --> Client : 400/401 или External 503\nбез audit pair и body demand
  else identity нормализована
    Identity --> Executor : dispatch caller continuation\nunder its own request context
    Executor -> Source : принять с обратным давлением и квотами
    Source --> Proxy : полный источник
    Proxy -> Workflow : передать владение источником
    Workflow -> Parser : открыть представление только для чтения
    Parser --> Workflow : атрибуты, фрагменты, gaps или typed failure
    alt parse/context/selection без detector work
      Workflow --> Proxy : Forward или stable Reject\nбез audit pair
    else начинается detector execution
      Workflow -> Engine : выбрать policies
      Engine --> Workflow : callback перед detector execution
      Workflow -> Audit : policy.analysis_started
      Workflow -> Engine : проверить все независимые fragments
      Engine --> Workflow : complete decisions / technical failure
      alt technical failure
        Workflow -> Audit : completed ERROR без reaction
        Workflow -> Source : закрыть owner и освободить quota
        Workflow --> Proxy : Reject(Inspection)
      else policy BLOCK или structural MASK
        Workflow -> Audit : completed reaction=BLOCK
        Workflow -> Source : закрыть owner и освободить quota
        Workflow --> Proxy : Reject(Blocked)
      else ALLOW или free-text MASK
        alt MASK
          Workflow -> Rewriter : validate raw tokens + canonical instructions
          Rewriter --> Workflow : non-expanding compact patches или failure
          opt валидация patches успешна
            Workflow -> Ready : подготовить owner + patches
            Ready --> Workflow : ready replay или failure
          end
        else ALLOW
          Workflow -> Ready : подготовить original replay owner
          Ready --> Workflow : ready replay или SafeSourceFailure
        end
        alt MASK: валидация или подготовка replay завершилась отказом
          Workflow -> Audit : completed ERROR, INSPECTION_FAILED\nбез reaction
          Workflow -> Source : закрыть owner и освободить quota
          Workflow --> Proxy : Reject(Inspection)
        else ALLOW: original replay недоступен
          Workflow -> Audit : completed ERROR, исходный source code\nбез reaction
          Workflow -> Source : закрыть owner и освободить quota
          Workflow --> Proxy : Reject(Source)
        else replay готов
          Workflow -> Audit : completed reaction=ALLOW/MASK
          Workflow --> Proxy : Forward(ready replay)
        end
      end
      note right of Audit
        Queue delivery и stdout write
        не ожидаются request path.
      end note
    end
    opt Reject
      Proxy --> Client : stable HTTP error через rejectionResponse\nsourceError для Reject(Source)\n403 policy BLOCK; 503 inspection failure\nбез upstream
    end
    opt Forward и handoff claim принят до cancellation/shutdown
    Proxy -> Transport : одноразовая передача original/patched replay
    Transport -> Upstream : original/patched bytes и end-to-end headers
    Upstream --> Transport : status, headers и поток body
    Transport --> Proxy : streaming HttpResponse
    Proxy -> ResponseHandler : передать upstream response
    ResponseHandler -> ResponseSource : retain body с one-item demand
    note right of ResponseSource
      Client пока не получает status,
      headers или body. Ordinary response
      завершается по EOF, SSE по standalone [DONE].
    end note
    ResponseSource --> ResponseHandler : complete source
    ResponseHandler -> Executor : protocol/policy work вне event loop
    Executor -> ResponseWorkflow : complete retained source
    ResponseWorkflow -> ResponseParser : полный read-only view
    alt malformed/ambiguous/incomplete/interrupted response
      ResponseParser --> ResponseWorkflow : typed protocol failure
      ResponseWorkflow --> ResponseHandler : Reject invalid upstream
      ResponseHandler --> Client : 502 invalid_upstream_response
    else valid ordinary JSON или SSE response
      ResponseParser --> ResponseWorkflow : fragments, gaps, source map
      ResponseWorkflow -> Engine : response context + independent fragments
      Engine --> ResponseWorkflow : callback before detector execution
      ResponseWorkflow -> Audit : RESPONSE analysis_started
      Engine --> ResponseWorkflow : decisions / technical failure
      alt ALLOW
        ResponseWorkflow -> ResponseReplay : original source
      else MASK
        ResponseWorkflow -> ResponseRewriter : validate and patch JSON/SSE exact spans
        ResponseRewriter --> ResponseWorkflow : rewritten bytes or typed failure
        ResponseWorkflow -> ResponseReplay : masked body + rewritten headers
      else BLOCK / 503
        ResponseWorkflow --> ResponseHandler : Reject
        ResponseHandler --> Client : safe VIG-29 response
      end
      ResponseWorkflow -> Audit : RESPONSE analysis_completed
      ResponseReplay --> ResponseHandler : one-shot transport claim
      ResponseHandler --> Client : final status/headers/body\nпо client demand
    end
    end
  end
end
@enduml
