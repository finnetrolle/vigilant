# Пример конфигурации Vigilant (HOCON).
# Поиск файла: $VIGILANT_CONFIG, затем ./vigilant.conf, затем /etc/vigilant/vigilant.conf.
# Переменные окружения VIGILANT_UPSTREAM_URL, VIGILANT_PORT, VIGILANT_UPSTREAM_*_TIMEOUT,
# VIGILANT_SHUTDOWN_*, VIGILANT_INSPECTION_*, VIGILANT_TRACING_*,
# VIGILANT_IDENTITY_* и VIGILANT_OTLP_ENABLED переопределяют значения файла.
vigilant {
  upstream-url = "http://127.0.0.1:18081"
  port = 8080

  # Таймауты upstream-клиента (модель - в docs/runtime-contract.md).
  upstream-connect-timeout = 10s         # установка соединения с upstream
  upstream-write-timeout = 30s           # запись запроса в upstream
  upstream-response-timeout = 5m         # первый объект ответа + пауза между чанками
  upstream-connection-idle-timeout = 10s # жизнь простаивающего соединения в пуле

  # Graceful shutdown: gap без активных запросов и абсолютный force bound.
  shutdown-quiet-period = 5s
  shutdown-force-timeout = 30s

  # Bounded in-memory source для request-side shadow inspection.
  inspection-per-request-limit-bytes = 8388608
  inspection-global-retained-limit-bytes = 67108864
  inspection-max-concurrent-request-sources = 128
  inspection-max-retained-segments-per-request = 128

  # Header с opaque session ID и header со значением W3C traceparent.
  # tracestate, если он есть, остаётся стандартным header tracestate.
  tracing-session-header = "x-session-id"
  tracing-traceparent-header = "traceparent"

  # Ровно один identity mode: ANONYMOUS, TRUSTED_HEADERS или BASIC.
  identity-mode = "ANONYMOUS"
  # Для TRUSTED_HEADERS настройте хотя бы один header и непустой CIDR list:
  # identity-user-header = "x-vigilant-user"
  # identity-groups-header = "x-vigilant-groups"
  # identity-trusted-cidrs = ["127.0.0.0/8", "2001:db8::/32"]

  # OTLP JSON Lines traces и metrics в stdout. Сетевого подключения к Collector нет.
  otlp-enabled = true
}
