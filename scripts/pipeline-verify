#!/usr/bin/env bash

# One durable final gate: early detekt, then verifyAll (owns build and OWASP).
# Public invocation returns immediately with new/reused evidence and a run ID.
# Poll check-run wait/status; successful dispatch is not a verification PASS.
set -euo pipefail
cd "$(dirname -- "${BASH_SOURCE[0]}")/.."

if [[ "${1:-}" == "--execute" && "$#" == 1 ]]; then
    if ! grep -Eq 'failBuildOnCVSS[[:space:]]*=' build.gradle.kts; then
        printf '%s\n' 'ENVIRONMENT FAILURE: configure dependencyCheck.failBuildOnCVSS before verification.' >&2
        exit 2
    fi
    ./gradlew detekt
    # External-data evidence must originate in this session, even if Gradle
    # retained an UP-TO-DATE report from a previous task. Rerun only this task.
    ./gradlew verifyAll dependencyCheckAnalyze --rerun
    exit 0
fi

snapshot=''
wave=0
tools=()
while [[ "$#" -gt 0 ]]; do
    case "$1" in
        --snapshot|--wave|--tool)
            if [[ "$#" -lt 2 || -z "$2" ]]; then
                printf 'error: "missing value"\nhelp: "pipeline-verify --snapshot <id> --tool <JDK-home> --tool <Gradle-distribution> [--wave <n>]"\n'
                exit 2
            fi
            case "$1" in
                --snapshot) snapshot="$2" ;;
                --wave) wave="$2" ;;
                --tool) tools+=(--tool "$2") ;;
            esac
            shift 2 ;;
        --help)
            printf '%s\n' 'pipeline-verify --snapshot <verification-session-id> --tool <JDK-home> --tool <Gradle-distribution> [--wave <n>]' \
                'Declare all installed JDK/analyzer/Gradle inputs; repeat --tool as needed. One snapshot per task verification session.' \
                'Example: pipeline-verify --snapshot VIG-40-local-1 --tool "$JAVA_HOME" --tool /path/to/gradle-9.4.1'
            exit 0 ;;
        *)
            printf 'error: "unknown argument"\nhelp: "use --snapshot, --tool, --wave or --help"\n'
            exit 2 ;;
    esac
done
if [[ -z "$snapshot" || "${#tools[@]}" == 0 ]]; then
    printf 'error: "snapshot and installed toolchain declarations are required"\nhelp: "pipeline-verify --snapshot <id> --tool <JDK-home> --tool <Gradle-distribution>"\n'
    exit 2
fi

gradle_user_dir="${GRADLE_USER_HOME:-$HOME/.gradle}"
extra=(--tool "$gradle_user_dir/gradle.properties" --tool "$gradle_user_dir/init.d"
       --tool "$gradle_user_dir/init.gradle" --tool "$gradle_user_dir/init.gradle.kts")
# verifyAll includes documentation/catalog fixtures, so their inputs belong here.
# Narrow runtime/affected runs may explicitly exclude docs using check-run --input.
exec ./scripts/check-run start --label final-verify --snapshot "$snapshot" --gate full --wave "$wave" \
    --timeout 3600 --env-key NVD_API_KEY --env-key HOME \
    --artifact directory:build/test-results/test \
    --artifact directory:build/test-results/processTest \
    --artifact directory:build/test-results/workItemValidatorTest \
    --artifact directory:build/reports/tests/test \
    --artifact directory:build/reports/tests/processTest \
    --artifact file:build/reports/detekt/detekt.xml \
    --artifact file:build/reports/dependency-check/dependency-check-report.html \
    "${tools[@]}" "${extra[@]}" -- ./scripts/pipeline-verify --execute
